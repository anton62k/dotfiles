# Font (requires Nerd Font: brew install --cask font-jetbrains-mono-nerd-font)
font-family = JetBrainsMono Nerd Font
font-size = 14

# Theme
theme = catppuccin-mocha

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true
macos-titlebar-style = hidden

# Disable native tabs/splits — tmux handles this
keybind = super+t=unbind
keybind = super+d=unbind

# Pass Option as Alt for tmux keybindings
macos-option-as-alt = true
