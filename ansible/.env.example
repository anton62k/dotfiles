# Copy this file to .env and keep the real file private.
# run-playbook.sh loads it before invoking Ansible.

GIT_PROFILES_FILE="$PWD/local/git-profiles.yml"
GIT_SSH_SERVER_ID=development-server
GIT_SSH_KEY_TITLE_PREFIX=dotfiles

# Values identify controller-side accounts already authenticated with `gh`.
# Tokens stay in the controller credential store and are never copied remotely.
GIT_SSH_ACCOUNT_DEFAULT=default-account
GIT_SSH_ACCOUNT_PROFILE_ONE=example-account
GIT_SSH_ACCOUNT_PROFILE_TWO=another-example-account
